#!/usr/bin/env python3
"""Read-only bridge configuration inspection for Omakeez."""
import argparse
import difflib
import hashlib
import json
import os
import re
import stat
import subprocess
import sys
import tempfile
import time
import fcntl
import shutil
from pathlib import Path

BEGIN = "-- >>> Omakeez managed bridge >>>"
END = "-- <<< Omakeez managed bridge <<<"
PLUGIN_ROOT = Path(__file__).resolve().parent.parent
BRIDGE_PATH = PLUGIN_ROOT / "bridge.lua"
BLOCK = BEGIN + "\npcall(dofile, " + json.dumps(str(BRIDGE_PATH)) + ")\n" + END
REASON_CODES = {
    "ok", "missing", "dangling-symlink", "symlink-loop", "non-regular",
    "wrong-owner", "not-writable", "outside-safe-root", "multiple-hardlinks",
    "duplicate-markers", "malformed-markers", "changed-since-inspect",
    "syntax-error", "hyprland-error", "concurrent-change", "unsupported",
}


def output(value, error=False):
    print(json.dumps(value, ensure_ascii=False, separators=(",", ":")), file=sys.stderr if error else sys.stdout)


def fail(code, message):
    output({"ok": False, "code": code, "message": message}, True)
    raise SystemExit(1)


def directory_open_flags():
    return os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW


def prepare_state_dir(path):
    state_fd = None
    try:
        try:
            info = path.lstat()
        except FileNotFoundError:
            path.mkdir(parents=True, mode=0o700, exist_ok=True)
        else:
            if stat.S_ISLNK(info.st_mode):
                fail("unsafe-state-directory", "state path must not be a symlink")
            if not stat.S_ISDIR(info.st_mode):
                fail("unsafe-state-directory", "state path is not a directory")

        # Open the leaf without following a replacement symlink, then validate
        # and use this descriptor for controller state operations.
        state_fd = os.open(path, directory_open_flags())
        info = os.fstat(state_fd)
        if not stat.S_ISDIR(info.st_mode):
            os.close(state_fd)
            state_fd = None
            fail("unsafe-state-directory", "state path is not a directory")
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) & 0o077:
            os.close(state_fd)
            state_fd = None
            fail("unsafe-state-directory", "state directory ownership or permissions are unsafe")
        os.fchmod(state_fd, 0o700)
        return state_fd
    except OSError as exc:
        if state_fd is not None:
            os.close(state_fd)
        fail("unsafe-state-directory", str(exc))


def open_state_lock(state_fd):
    lock_fd = None
    try:
        lock_fd = os.open(
            "bridge-control.lock",
            os.O_RDWR | os.O_CREAT | os.O_APPEND | os.O_NOFOLLOW,
            0o600,
            dir_fd=state_fd,
        )
        info = os.fstat(lock_fd)
        if not stat.S_ISREG(info.st_mode) or info.st_uid != os.getuid():
            os.close(lock_fd)
            lock_fd = None
            fail("unsafe-state-directory", "controller lock is not a user-owned regular file")
        os.fchmod(lock_fd, 0o600)
        lock = os.fdopen(lock_fd, "a+")
        lock_fd = None
        return lock
    except OSError as exc:
        if lock_fd is not None:
            os.close(lock_fd)
        fail("unsafe-state-directory", str(exc))


def open_state_subdirectory(parent_fd, name):
    try:
        try:
            os.mkdir(name, 0o700, dir_fd=parent_fd)
        except FileExistsError:
            pass
        directory_fd = os.open(name, directory_open_flags(), dir_fd=parent_fd)
        info = os.fstat(directory_fd)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            os.close(directory_fd)
            fail("unsafe-state-directory", f"{name} is not a user-owned directory")
        os.fchmod(directory_fd, 0o700)
        return directory_fd
    except OSError as exc:
        fail("unsafe-state-directory", str(exc))


def write_state_file(directory_fd, name, content):
    file_fd = None
    try:
        file_fd = os.open(
            name,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
            dir_fd=directory_fd,
        )
        os.fchmod(file_fd, 0o600)
        with os.fdopen(file_fd, "wb") as handle:
            file_fd = None
            handle.write(content)
    except OSError as exc:
        if file_fd is not None:
            os.close(file_fd)
        fail("unsafe-state-directory", str(exc))


def create_backup(state_fd, state_dir, current_hash, original, metadata):
    backups_fd = open_state_subdirectory(state_fd, "backups")
    backup_name = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime()) + "-" + current_hash[7:19]
    try:
        os.mkdir(backup_name, 0o700, dir_fd=backups_fd)
        backup_fd = os.open(backup_name, directory_open_flags(), dir_fd=backups_fd)
        info = os.fstat(backup_fd)
        if not stat.S_ISDIR(info.st_mode) or info.st_uid != os.getuid():
            os.close(backup_fd)
            fail("unsafe-state-directory", "backup path is not a user-owned directory")
        os.fchmod(backup_fd, 0o700)
        write_state_file(backup_fd, "content", original)
        write_state_file(backup_fd, "metadata.json", (json.dumps(metadata, indent=2) + "\n").encode("utf-8"))
        return state_dir / "backups" / backup_name, backup_fd
    except OSError as exc:
        fail("unsafe-state-directory", str(exc))
    finally:
        os.close(backups_fd)


def backup_list(state_dir):
    if not state_dir:
        return []
    backup_root = Path(state_dir) / "backups"
    try:
        entries = [item for item in backup_root.iterdir() if item.is_dir()]
    except OSError:
        return []
    entries.sort(key=lambda item: (item.stat().st_mtime_ns, item.name), reverse=True)
    result = []
    for item in entries:
        metadata = item / "metadata.json"
        details = {"path": str(item), "currentHash": None}
        try:
            details["createdAt"] = int(item.stat().st_mtime)
            value = json.loads(metadata.read_text(encoding="utf-8"))
            if isinstance(value, dict): details["currentHash"] = value.get("currentHash")
        except (OSError, ValueError):
            pass
        result.append(details)
    return result


def default_config():
    return Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config")) / "hypr" / "hyprland.lua"


def default_state():
    return Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local/state")) / "omarchy/omakeez"


def under(path, parent):
    try:
        path.relative_to(parent)
        return True
    except ValueError:
        return False


def resolve_path(logical):
    try:
        return logical.resolve(strict=True), None
    except RuntimeError:
        return None, "symlink-loop"
    except FileNotFoundError:
        if logical.is_symlink():
            return None, "dangling-symlink"
        return None, "missing"
    except OSError:
        return None, "unsupported"


def git_details(target):
    try:
        root_text = subprocess.check_output(
            ["git", "-C", str(target.parent), "rev-parse", "--show-toplevel"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
    except (OSError, subprocess.CalledProcessError):
        return None, False
    root = Path(root_text).resolve()
    try:
        dirty = bool(subprocess.check_output(
            ["git", "-C", str(root), "status", "--porcelain", "--", str(target)],
            text=True, stderr=subprocess.DEVNULL,
        ).strip())
    except (OSError, subprocess.CalledProcessError):
        dirty = False
    return root, dirty


def marker_state(text):
    begins, ends = [m.start() for m in re.finditer(re.escape(BEGIN), text)], [m.start() for m in re.finditer(re.escape(END), text)]
    if not begins and not ends:
        return "absent", None
    if len(begins) > 1 or len(ends) > 1:
        return "invalid", "duplicate-markers"
    if len(begins) != 1 or len(ends) != 1:
        return "invalid", "malformed-markers"
    start, finish = begins[0], ends[0]
    if finish < start or text.find("\n", finish) == -1 and finish + len(END) != len(text):
        return "invalid", "malformed-markers"
    block_end = finish + len(END)
    if text[start:block_end] != BLOCK and text[start:block_end] != BLOCK + "\n":
        return "invalid", "malformed-markers"
    if start and text[start - 1] != "\n":
        return "invalid", "malformed-markers"
    return "present", None


def insertion(text):
    # A final top-level return must remain the last executable form.
    lines = text.splitlines(keepends=True)
    depth = 0
    final_return = None
    for index, line in enumerate(lines):
        stripped = line.strip()
        if stripped.startswith("return ") or stripped == "return":
            if depth == 0:
                final_return = index
        depth += line.count("{") - line.count("}")
    if final_return is not None:
        prefix = "".join(lines[:final_return])
        if prefix and not prefix.endswith("\n"):
            prefix += "\n"
        return prefix + BLOCK + "\n" + "".join(lines[final_return:])
    if text and not text.endswith("\n"):
        text += "\n"
    return text + BLOCK + "\n"


def remove_block(text):
    pattern = re.compile(r"(^|\n)" + re.escape(BEGIN) + r"\n.*?" + re.escape(END) + r"(?=\n|$)\n?", re.S)
    return pattern.sub(lambda match: match.group(1), text, count=1)


def diff_text(old, new, path):
    return "".join(difflib.unified_diff(
        old.splitlines(True), new.splitlines(True),
        fromfile=str(path), tofile=str(path), n=3,
    ))


def inspect(logical, state_dir):
    result = {
        "schemaVersion": 1,
        "logicalPath": str(logical),
        "resolvedPath": None,
        "symlinked": logical.is_symlink(),
        "gitManaged": False,
        "gitRoot": None,
        "gitDirty": False,
        "fileType": None,
        "ownerUid": None,
        "mode": None,
        "writable": False,
        "safeToPatch": False,
        "reasonCode": "missing",
        "currentHash": None,
        "managedBlockState": "absent",
        "proposedDiff": "",
        "lineEnding": None,
        "device": None,
        "inode": None,
        "hardLinks": None,
        "backups": backup_list(state_dir),
    }
    target, error = resolve_path(logical)
    if error:
        result["reasonCode"] = error
        result["proposedDiff"] = ""
        return result
    result["resolvedPath"] = str(target)
    try:
        info = target.stat()
        result.update({
            "fileType": "regular" if stat.S_ISREG(info.st_mode) else "directory" if stat.S_ISDIR(info.st_mode) else "other",
            "ownerUid": info.st_uid,
            "mode": format(stat.S_IMODE(info.st_mode), "04o"),
            "writable": os.access(target, os.W_OK),
            "device": info.st_dev,
            "inode": info.st_ino,
            "hardLinks": info.st_nlink,
        })
    except OSError:
        result["reasonCode"] = "missing"
        return result
    if result["fileType"] != "regular":
        result["reasonCode"] = "non-regular"
        return result
    try:
        text = target.read_text(encoding="utf-8")
    except (OSError, UnicodeDecodeError) as exc:
        result["reasonCode"] = "unsupported"
        result["error"] = str(exc)
        return result
    result["lineEnding"] = "CRLF" if "\r\n" in target.read_bytes().decode("utf-8", "replace") else "LF"
    result["currentHash"] = "sha256:" + hashlib.sha256(target.read_bytes()).hexdigest()
    state, marker_error = marker_state(text)
    result["managedBlockState"] = "present" if state == "present" else state
    home = Path.home().resolve()
    git_root, dirty = git_details(target)
    if git_root:
        result["gitManaged"], result["gitRoot"], result["gitDirty"] = True, str(git_root), dirty
    allowed = under(target, home) or (git_root and under(target, git_root))
    if os.getuid() != info.st_uid:
        result["reasonCode"] = "wrong-owner"
    elif not result["writable"]:
        result["reasonCode"] = "not-writable"
    elif info.st_nlink != 1:
        result["reasonCode"] = "multiple-hardlinks"
    elif not allowed or (git_root and (os.stat(git_root).st_uid != os.getuid() or not os.access(git_root, os.W_OK))):
        result["reasonCode"] = "outside-safe-root"
    elif marker_error:
        result["reasonCode"] = marker_error
    else:
        result["reasonCode"] = "ok"
        result["safeToPatch"] = True
    if state == "absent":
        proposed = insertion(text)
    elif state == "present":
        proposed = remove_block(text)
    else:
        proposed = text
    result["proposedDiff"] = diff_text(text, proposed, target)
    return result


def mutate(command, args):
    if not args.expected_hash:
        fail("invalid-arguments", "--expected-hash is required")
    if not shutil.which("luac"):
        fail("missing-luac", "luac is required for safe configuration validation")
    if not args.no_live_reload and not shutil.which("hyprctl"):
        fail("missing-hyprctl", "hyprctl is required for live configuration reload")
    logical = args.config or default_config()
    state_dir = args.state_dir or default_state()
    state_fd = prepare_state_dir(state_dir)
    try:
        mutate_with_state_dir(command, args, logical, state_dir, state_fd)
    finally:
        os.close(state_fd)


def mutate_with_state_dir(command, args, logical, state_dir, state_fd):
    with open_state_lock(state_fd) as lock:
        fcntl.flock(lock.fileno(), fcntl.LOCK_EX)
        before = inspect(logical, state_dir)
        if not before["safeToPatch"]:
            fail(before["reasonCode"], "configuration is not safe to patch")
        if before["currentHash"] != args.expected_hash and before["currentHash"] != "sha256:" + args.expected_hash:
            fail("changed-since-inspect", "configuration hash does not match expected hash")
        target = Path(before["resolvedPath"])
        original = target.read_bytes()
        text = original.decode("utf-8")
        state, marker_error = marker_state(text)
        if command == "enable":
            candidate = text if state == "present" else insertion(text)
        else:
            candidate = remove_block(text) if state == "present" else text
        if candidate == text:
            output({"ok": True, "changed": False, "logicalPath": str(logical), "resolvedPath": str(target), "oldHash": before["currentHash"], "newHash": before["currentHash"], "validation": "not-needed", "rolledBack": False})
            return
        candidate_bytes = candidate.encode("utf-8")
        syntax_fd, syntax_path = tempfile.mkstemp(prefix=".omakeez-syntax.", dir=target.parent)
        try:
            with os.fdopen(syntax_fd, "wb") as syntax_file:
                syntax_file.write(candidate_bytes)
            subprocess.run(["luac", "-p", syntax_path], check=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
        except (OSError, subprocess.CalledProcessError) as exc:
            fail("syntax-error", str(exc))
        finally:
            if os.path.exists(syntax_path):
                os.unlink(syntax_path)
        backup, backup_fd = create_backup(state_fd, state_dir, before["currentHash"], original, before)
        fd, temporary = tempfile.mkstemp(prefix=".omakeez.", dir=target.parent)
        try:
            os.fchmod(fd, 0o600)
            with os.fdopen(fd, "wb") as handle:
                handle.write(candidate_bytes)
                handle.flush()
                os.fsync(handle.fileno())
            os.chmod(temporary, stat.S_IMODE(target.stat().st_mode))
            os.replace(temporary, target)
        finally:
            if os.path.exists(temporary):
                os.unlink(temporary)
        new_hash = "sha256:" + hashlib.sha256(candidate_bytes).hexdigest()
        if not args.no_live_reload:
            reload_result = subprocess.run(["hyprctl", "reload"], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            errors = subprocess.run(["hyprctl", "configerrors"], text=True, stdout=subprocess.PIPE, stderr=subprocess.STDOUT)
            if reload_result.returncode != 0 or errors.returncode != 0 or errors.stdout.strip():
                if "sha256:" + hashlib.sha256(target.read_bytes()).hexdigest() == new_hash:
                    os.replace("content", target, src_dir_fd=backup_fd)
                    rolled_back = True
                else:
                    fail("concurrent-change", "target changed before rollback")
            else:
                rolled_back = False
        else:
            rolled_back = False
        os.close(backup_fd)
        output({"ok": True, "changed": True, "logicalPath": str(logical), "resolvedPath": str(target), "oldHash": before["currentHash"], "newHash": new_hash, "backupPath": str(backup), "validation": "skipped" if args.no_live_reload else "passed", "rolledBack": rolled_back})


def main():
    parser = argparse.ArgumentParser()
    parser.add_argument("command", choices=["inspect", "status", "manual-snippet", "enable", "disable"])
    parser.add_argument("--expected-hash")
    parser.add_argument("--no-live-reload", action="store_true")
    parser.add_argument("--config", type=Path, default=None)
    parser.add_argument("--state-dir", type=Path, default=None)
    args = parser.parse_args()
    if args.command == "manual-snippet":
        output({"ok": True, "schemaVersion": 1, "snippet": BLOCK})
        return
    if args.command in ("enable", "disable"):
        mutate(args.command, args)
        return
    result = inspect(args.config or default_config(), args.state_dir or default_state())
    if args.command == "status":
        result["integrationState"] = "enabled" if result["managedBlockState"] == "present" and result["safeToPatch"] else "disabled" if result["safeToPatch"] else "error"
    output(result)


if __name__ == "__main__":
    main()
